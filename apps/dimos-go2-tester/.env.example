# Required when not using discover mode.
ROBOT_IP=192.168.123.161

# Safe first test: basic. Other options: discover, nav, agentic,
# agentic-ollama, spatial, detection, shell, custom.
DIMOS_MODE=basic

# Only needed for DIMOS_MODE=custom.
DIMOS_BLUEPRINT=

# Optional extra args appended to `dimos run <blueprint>`.
DIMOS_EXTRA_ARGS=

# DimOS global config. These make the web dashboard usable from another LAN host.
VIEWER=rerun-web
LISTEN_HOST=0.0.0.0

# Needed by newer Go2 firmware for WebRTC camera/DimOS signaling.
# Prefer leaving this empty and placing the key in /data/dimos/unitree_aes_key
# on WendyOS persistent storage. For local Docker testing, env is also accepted.
UNITREE_AES_128_KEY=
GO2_AES_128_KEY=
UNITREE_AES_KEY_FILE=/data/dimos/unitree_aes_key

# Jetson usually uses nvidia. Set to runc if your Docker install does not
# expose an nvidia runtime and you are only testing basic connectivity.
DOCKER_RUNTIME=nvidia

# Required for DIMOS_MODE=agentic.
OPENAI_API_KEY=

# Used by DIMOS_MODE=agentic-ollama if your Ollama server is reachable.
OLLAMA_HOST=http://127.0.0.1:11434

# Only for DIMOS_MODE=provision-wifi.
WIFI_SSID=
WIFI_PASSWORD=
